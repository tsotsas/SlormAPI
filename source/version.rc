// Windows version information (Explorer, mod loaders and mod managers show it)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "thothas"
            VALUE "FileDescription", "SlormAPI - a modding API for The Slormancer"
            VALUE "FileVersion", "1.0.2"
            VALUE "InternalName", "SlormAPI"
            VALUE "LegalCopyright", "AGPL-3.0"
            VALUE "OriginalFilename", "SlormAPI.dll"
            VALUE "ProductName", "SlormAPI"
            VALUE "ProductVersion", "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
